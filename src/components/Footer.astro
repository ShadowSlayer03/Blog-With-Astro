---
import { SITE, SOCIALS } from '../lib/constants';
const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'System_RSS', href: '/rss.xml' },
  { label: 'Core_Mail', href: `mailto:contact@sslayer441@gmail.com` },
  { label: 'Source_Repo', href: `${SOCIALS.github}/Blog-With-Astro` },
];
---

<footer class="site-footer relative overflow-hidden border-t border-white/5 bg-[#050505] pt-24 pb-10">
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/3 pointer-events-none select-none opacity-[0.03]">
        <h2 class="site-footer-watermark text-[30vw] font-black leading-none text-white uppercase italic tracking-tighter">
      NAMBIAR
    </h2>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="text-center">
        <div class="group cursor-default">
                        <h2 class="site-footer-title-top text-[11vw] md:text-[10vw] font-heading leading-none tracking-tight text-transparent bg-clip-text bg-linear-to-b from-white to-slate-700 uppercase transition-transform duration-500 group-hover:-translate-y-2">
                ARJUN
            </h2>
                        <h2 class="site-footer-title-bottom text-[11vw] md:text-[10vw] font-heading leading-none tracking-tight text-transparent bg-clip-text bg-linear-to-t from-cyan-400 via-white to-white uppercase -mt-[4.5vw] transition-transform duration-500 group-hover:translate-y-2">
                NAMBIAR
            </h2>
        </div>

        <div class="mt-12 flex flex-col items-center gap-8">
            <div class="flex items-center gap-4">
                <div class="h-px w-8 bg-cyan-500/30"></div>
                <p class="font-mono text-[9px] md:text-[10px] tracking-[0.5em] text-slate-500 uppercase">
                    Creative Design // Development // Content Creation
                </p>
                <div class="h-px w-8 bg-cyan-500/30"></div>
            </div>
            
            <nav class="mt-8 flex flex-wrap justify-center gap-x-12 gap-y-4">
                {footerLinks.map((link) => (
                    <a 
                        href={link.href} 
                        class="site-footer-link font-mono text-[10px] text-slate-600 uppercase tracking-widest transition-colors hover:text-cyan-400 flex items-center gap-2 group"
                    >
                        <span class="site-footer-slash text-cyan-900 group-hover:text-cyan-400 transition-colors">//</span>
                        {link.label}
                    </a>
                ))}
            </nav>
        </div>
    </div>

    <div class="site-footer-meta mt-24 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 font-mono text-[8px] text-slate-500 uppercase tracking-[0.3em]">
        <div class="flex items-center gap-3">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-700/70 border border-cyan-400/30"></span>
            <span>© {currentYear} // {SITE.author}</span>
        </div>
        <div class="flex items-center gap-4">
            <span>LOC: 12.9716° N, 77.5946° E </span>
            <span class="text-slate-600">|</span>
            <span>V.1.0.4_STABLE</span>
        </div>
    </div>
  </div>
</footer>

<style is:global>
    html:not(.dark) .site-footer {
        border-top-color: rgba(226, 232, 240, 0.9);
        background: #ffffff;
    }

    html:not(.dark) .site-footer-watermark {
        color: #0f172a;
    }

    html:not(.dark) .site-footer-title-top {
        background-image: linear-gradient(to bottom, #0f172a, #94a3b8);
    }

    html:not(.dark) .site-footer-title-bottom {
        background-image: linear-gradient(to top, #06b6d4, #334155, #0f172a);
    }

    html:not(.dark) .site-footer-link {
        color: #64748b;
    }

    html:not(.dark) .site-footer-link:hover {
        color: #0891b2;
    }

    html:not(.dark) .site-footer-slash {
        color: #0f766e;
    }

    html:not(.dark) .site-footer-link:hover .site-footer-slash {
        color: #0891b2;
    }

    html:not(.dark) .site-footer-meta {
        border-top-color: rgba(226, 232, 240, 0.9);
    }
</style>