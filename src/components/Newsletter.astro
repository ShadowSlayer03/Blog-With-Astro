---
import { SITE } from "../lib/constants";
import BorderGlow from "./ui/BorderGlow";
---

<BorderGlow
  className="newsletter-shell w-full"
  edgeSensitivity={30}
  glowColor="180 100% 50%"
  backgroundColor="#07101d"
  borderRadius={28}
  glowRadius={40}
  glowIntensity={0.8}
  coneSpread={25}
  client:load
>
  <section
    class="newsletter-panel relative overflow-hidden px-6 py-10 sm:px-12 sm:py-14"
  >
    <div
      class="newsletter-grid pointer-events-none absolute inset-0 opacity-70"
      aria-hidden="true"
      style="background-image: linear-gradient(rgba(34, 211, 238, 0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(34, 211, 238, 0.025) 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>
    <div
      class="newsletter-orb-top pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-cyan-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="newsletter-orb-bottom pointer-events-none absolute -bottom-16 -left-16 h-48 w-48 rounded-full bg-sky-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-xl text-center">
      <div
        class="newsletter-icon mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl border border-cyan-500/20 bg-[#0c1626] text-cyan-300"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
          ></path>
        </svg>
      </div>

      <p
        class="newsletter-eyebrow mb-3 font-mono text-[10px] uppercase tracking-[0.35em] text-cyan-400/70"
      >
        Signal protocol
      </p>
      <h3
        class="newsletter-title mb-3 text-3xl font-black uppercase tracking-[-0.04em] text-white"
      >
        Initialize connection
      </h3>
      <p class="newsletter-copy mb-8 text-sm leading-7 text-slate-400 sm:text-base">
        Get notified when I publish something new on {SITE.title}. <br /> No noise,
        no spam, only the good stuff.
      </p>

      <form class="flex flex-col gap-3 sm:flex-row">
        <input
          type="email"
          placeholder="you@example.com"
          required
          class="newsletter-input flex-1 rounded-2xl border border-white/8 bg-[#020817] px-4 py-3 text-sm text-slate-100 outline-none transition-colors placeholder:text-slate-500 focus:border-cyan-400/50"
        />
        <button
          type="submit"
          class="newsletter-button rounded-2xl border border-cyan-400/20 bg-cyan-400 px-5 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-300"
        >
          Subscribe
        </button>
      </form>

      <p
        class="newsletter-meta mt-4 font-mono text-[10px] uppercase tracking-[0.3em] text-slate-500"
      >
        Join the {SITE.title} channel
      </p>
    </div>
  </section>
</BorderGlow>

<style is:global>
  html:not(.dark) .newsletter-shell {
    background: rgba(255, 255, 255, 0.94) !important;
    border-color: rgba(226, 232, 240, 0.95) !important;
    box-shadow: 0 20px 46px rgba(15, 23, 42, 0.08) !important;
  }

  html:not(.dark) .newsletter-panel {
    background:
      radial-gradient(circle at top, rgba(14, 116, 144, 0.08), transparent 42%),
      linear-gradient(180deg, rgba(248, 250, 252, 0.98) 0%, rgba(241, 245, 249, 0.9) 100%);
  }

  html:not(.dark) .newsletter-grid {
    opacity: 0.55;
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px) !important;
  }

  html:not(.dark) .newsletter-orb-top {
    background: rgba(14, 165, 233, 0.1);
  }

  html:not(.dark) .newsletter-orb-bottom {
    background: rgba(8, 145, 178, 0.08);
  }

  html:not(.dark) .newsletter-icon {
    border-color: rgba(14, 165, 233, 0.18);
    background: #f1f5f9;
    color: #0f766e;
  }

  html:not(.dark) .newsletter-eyebrow {
    color: rgba(8, 145, 178, 0.62);
  }

  html:not(.dark) .newsletter-title {
    color: #0f172a;
  }

  html:not(.dark) .newsletter-copy {
    color: #475569;
  }

  html:not(.dark) .newsletter-input {
    border-color: rgba(226, 232, 240, 0.95);
    background: #f8fafc;
    color: #0f172a;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  html:not(.dark) .newsletter-input::placeholder {
    color: #94a3b8;
  }

  html:not(.dark) .newsletter-input:focus {
    border-color: rgba(8, 145, 178, 0.35);
  }

  html:not(.dark) .newsletter-button {
    border-color: transparent;
    background: #0f172a;
    color: #f8fafc;
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
  }

  html:not(.dark) .newsletter-button:hover {
    border-color: #0f172a;
    background: #1e293b;
  }

  html:not(.dark) .newsletter-meta {
    color: #94a3b8;
  }
</style>
