---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../lib/constants";
import { getCollection } from "astro:content";
import Search from "astro-pagefind/components/Search";
import { getReadingTime, formatDate } from "../../lib/utils";
import MagicBentoBlogGrid from "../../components/islands/MagicBentoBlogGrid";
import GradientText from "../../components/ui/GradientText";
import MagicFeaturedBlogCard from "../../components/islands/MagicFeaturedBlogCard";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsWithMetadata = await Promise.all(
  posts.map(async (post) => {
    const readingTime = post.body ? getReadingTime(post.body) : 1;
    return { ...post, readingTime };
  }),
);

const featuredPost = postsWithMetadata[0];
const featuredArchivePost = featuredPost
  ? {
      slug: featuredPost.id,
      title: featuredPost.data.title,
      description: featuredPost.data.description,
      heroImage: featuredPost.data.heroImage ?? null,
      tag: featuredPost.data.tags[0] ?? "GENERAL",
      date: formatDate(featuredPost.data.pubDate, "short").toUpperCase(),
      readingTime: featuredPost.readingTime,
      authorHandle: SITE.author.toUpperCase().replace(/\s+/g, "_"),
    }
  : null;

const remainingPosts = postsWithMetadata.slice(1);

const archivePosts = remainingPosts.map((post) => {
  const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
  const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
  return {
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    heroImage: post.data.heroImage ?? null,
    tag: post.data.tags[0] ?? "GENERAL",
    date: formatDate(post.data.pubDate, "short").toUpperCase(),
    readingTime: readingMinutes,
  };
});

const authorHandle = SITE.author.toUpperCase().replace(/\s+/g, "_");

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .sort()
  .slice(0, 4);
const tagCounts = new Map<string, number>();
posts.forEach((post) =>
  post.data.tags.forEach((tag) =>
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1),
  ),
);
---

<BaseLayout
  title={`Blog - ${SITE.title}`}
  description="All blog posts about web development, side projects, and building in public."
>
  <div
    class="archive-backdrop fixed inset-0 -z-10 pointer-events-none overflow-hidden bg-[#040916]"
  >
    <div
      class="archive-backdrop-grid absolute inset-0 opacity-35"
      style="background-image: linear-gradient(rgba(34, 211, 238, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(34, 211, 238, 0.03) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>
    <div
      class="archive-backdrop-gradient absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(8,145,178,0.14),transparent_34%),linear-gradient(180deg,#040916_0%,#071121_55%,#050b16_100%)]"
    >
    </div>
    <div
      class="archive-backdrop-orb absolute left-1/2 top-0 h-160 w-160 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-[120px]"
    >
    </div>
  </div>

  <section
    class="archive-page relative z-10 mx-auto max-w-6xl px-6 py-16 md:py-20"
  >
    <div class="mb-16 flex flex-col items-center text-center md:mb-18">
      <div
        class="archive-eyebrow mb-8 inline-flex flex-wrap items-center justify-center gap-3 rounded-sm border border-cyan-500/20 bg-[#091426]/85 px-3 py-2 font-mono text-[9px] font-bold uppercase tracking-[0.24em] shadow-[0_10px_30px_rgba(0,0,0,0.22)] sm:px-4 sm:tracking-[0.32em]"
      >
        <span class="archive-eyebrow-label text-cyan-400">PERSONAL_BLOGS</span>
        <span class="archive-eyebrow-slash text-slate-600">//</span>
        <span class="archive-eyebrow-handle text-slate-300">{authorHandle}</span
        >
      </div>

      <GradientText animationSpeed={6} showBorder={false} client:load>
        <h1
          class="font-heading text-[9vw] md:text-[7vw] tracking-normal uppercase leading-none"
        >
          THE_ARCHIVE
        </h1>
      </GradientText>
    </div>

    <div class="relative mx-auto mb-20 max-w-2xl md:mb-24">
      <div
        id="search-wrapper"
        class="archive-search-shell group relative overflow-hidden rounded-[14px] border border-cyan-500/12 bg-[#081121]/95 shadow-[0_14px_40px_rgba(0,0,0,0.28)] transition-all duration-300 focus-within:border-cyan-500/30 focus-within:shadow-[0_14px_40px_rgba(34,211,238,0.08)]"
      >
        <Search
          id="search"
          className="pagefind-ui"
          uiOptions={{ showImages: false, resetStyles: false }}
        />
      </div>
    </div>

    <div class="mb-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] xl:gap-10">
      {
        featuredArchivePost && (
          <MagicFeaturedBlogCard
            client:load
            post={featuredArchivePost}
            enableBorderGlow={true}
            enableTilt={true}
            enableMagnetism={false}
            clickEffect={true}
            particleCount={15}
          />
        )
      }

      <div class="flex flex-col gap-6">
        <div
          class="archive-topics-card flex flex-1 flex-col rounded-[22px] border border-white/6 bg-[#0c1421]/92 p-6 shadow-[0_20px_50px_rgba(0,0,0,0.22)] backdrop-blur-sm"
        >
          <div class="mb-5 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg
                class="w-4 h-4 text-cyan-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"
                ></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <h3
                class="archive-topics-title font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-white"
              >
                HOT_TOPICS
              </h3>
            </div>
            <span
              class="archive-topics-count font-mono text-[8px] uppercase tracking-[0.3em] text-slate-600"
            >
              {allTags.length} TAGS
            </span>
          </div>

          <div class="archive-topics-divider border-t border-white/5 pt-4">
            <ul class="space-y-2">
              {
                allTags.map((tag, i) => (
                  <li>
                    <a
                      href={`/blog/tag/${tag}`}
                      class="archive-topic-link group/tag flex items-center gap-3 rounded-lg px-3 py-2.5 font-mono text-[10px] uppercase tracking-[0.2em] text-slate-400 transition-all duration-200 hover:bg-cyan-500/5 hover:text-cyan-300"
                    >
                      <span class="archive-topic-index text-slate-600 transition-colors group-hover/tag:text-cyan-500">
                        #{String(i + 1).padStart(2, "0")}_
                      </span>
                      <span class="flex-1">{tag.replace(/\s+/g, "_")}</span>
                      <span class="archive-topic-chip flex h-5 w-5 items-center justify-center rounded bg-[#0f1a2e] text-[8px] text-slate-500 transition-colors group-hover/tag:bg-cyan-500/10 group-hover/tag:text-cyan-400">
                        {tagCounts.get(tag) || 0}
                      </span>
                      <svg
                        class="archive-topic-chevron h-3 w-3 text-slate-700 transition-all duration-200 group-hover/tag:translate-x-0.5 group-hover/tag:text-cyan-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9 5l7 7-7 7"
                        />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div
          class="archive-join-card flex flex-1 flex-col justify-center rounded-[22px] border border-white/6 bg-[#0a121e]/88 p-6 text-center shadow-[0_20px_50px_rgba(0,0,0,0.22)] backdrop-blur-sm"
        >
          <div
            class="archive-join-icon mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full border border-cyan-500/20 bg-[#132238] text-cyan-400"
          >
            <span class="font-mono text-lg leading-none">@</span>
          </div>
          <h3
            class="archive-join-title mb-2 text-[15px] font-bold uppercase tracking-wider text-white"
          >
            JOIN THE CORE
          </h3>
          <p
            class="archive-join-copy mb-6 text-xs leading-relaxed text-slate-400"
          >
            Get technical deep-dives delivered to your terminal weekly.
          </p>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input
              type="email"
              placeholder="user@architect.os"
              class="archive-join-input w-full rounded border border-white/10 bg-[#050b14] px-4 py-2 text-xs font-mono text-white placeholder-slate-600 focus:border-cyan-500/50 focus:outline-none"
            />
            <button
              class="archive-join-button rounded border border-transparent bg-[#67e8f9] px-4 py-2 font-mono text-[10px] font-bold uppercase tracking-wider whitespace-nowrap text-black transition-colors hover:border-[#67e8f9] hover:bg-[#a5f3fc] sm:self-auto"
            >
              EXECUTE
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-16">
      <MagicBentoBlogGrid
        client:load
        posts={archivePosts}
        textAutoHide={true}
        enableSpotlight={true}
        enableBorderGlow={true}
        enableTilt={true}
        enableMagnetism={false}
        clickEffect={true}
        spotlightRadius={400}
        particleCount={12}
        disableAnimations={false}
      />
    </div>

    {
      remainingPosts.length > 5 && (
        <div class="mt-12 mb-16 flex justify-center">
          <div class="archive-pagination-shell flex items-center gap-2 rounded border border-white/10 bg-[#071121] px-2 py-1 font-mono text-[10px] opacity-80 shadow-lg backdrop-blur-sm">
            <button class="archive-pagination-arrow flex h-8 w-8 items-center justify-center text-slate-500 hover:text-white transition-colors">
              &lt;
            </button>
            <div class="flex items-center gap-1">
              <span class="archive-pagination-current flex h-8 w-8 items-center justify-center bg-cyan-400 text-slate-950 font-bold rounded-sm">
                01
              </span>
              <span class="archive-pagination-page flex h-8 w-8 items-center justify-center text-slate-400 hover:text-white transition-colors cursor-pointer">
                02
              </span>
              <span class="archive-pagination-page flex h-8 w-8 items-center justify-center text-slate-400 hover:text-white transition-colors cursor-pointer">
                03
              </span>
              <span class="archive-pagination-dots flex h-8 w-8 items-center justify-center text-slate-600">
                ...
              </span>
              <span class="archive-pagination-page flex h-8 w-8 items-center justify-center text-slate-400 hover:text-white transition-colors cursor-pointer">
                12
              </span>
            </div>
            <button class="archive-pagination-arrow flex h-8 w-8 items-center justify-center text-slate-500 hover:text-white transition-colors">
              &gt;
            </button>
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

<style is:global>

  /* — Pagefind wrapper — */
  #search-wrapper {
    --pagefind-ui-primary: #22d3ee;
    --pagefind-ui-text: #94a3b8;
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: transparent;
    --pagefind-ui-tag: #22d3ee;
    --pagefind-ui-border-width: 0px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-image-border-radius: 12px;
    --pagefind-ui-image-box-ratio: 0;
    --pagefind-ui-font: ui-monospace, "JetBrains Mono", monospace;
    --pagefind-ui-scale: 0.7;
  }

  #search-wrapper .pagefind-ui__drawer {
    border: 1px solid rgba(34, 211, 238, 0.1) !important;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.55),
      0 0 32px rgba(34, 211, 238, 0.04);
    z-index: 50;
    padding: 0 1rem;
  }

  #search-wrapper .pagefind-ui__search-input::placeholder {
    color: #979ca3;
  }

  #search-wrapper .pagefind-ui__results-area {
    margin-top: 0 !important;
  }

  #search-wrapper .pagefind-ui__result:first-child {
    border-top: rgba(34, 211, 238, 0.1) solid 1px !important;
  }

  html:not(.dark) .archive-backdrop {
    background: #f8fafc;
  }

  html:not(.dark) .archive-backdrop-grid {
    opacity: 0.45;
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px) !important;
  }

  html:not(.dark) .archive-backdrop-gradient {
    background:
      radial-gradient(circle at top, rgba(14, 116, 144, 0.12), transparent 34%),
      linear-gradient(180deg, #f8fafc 0%, #eef4fb 52%, #f8fafc 100%) !important;
  }

  html:not(.dark) .archive-backdrop-orb {
    background: rgba(14, 165, 233, 0.1);
  }

  html:not(.dark) .archive-page .archive-eyebrow {
    border-color: rgba(148, 163, 184, 0.35);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
  }

  html:not(.dark) .archive-page .archive-eyebrow-label {
    color: #0f766e;
  }

  html:not(.dark) .archive-page .archive-eyebrow-slash {
    color: #94a3b8;
  }

  html:not(.dark) .archive-page .archive-eyebrow-handle {
    color: #334155;
  }

  html:not(.dark) .archive-page .archive-search-shell {
    border-color: rgba(148, 163, 184, 0.28);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
  }

  html:not(.dark) .archive-page .archive-topics-card,
  html:not(.dark) .archive-page .archive-join-card,
  html:not(.dark) .archive-page .archive-pagination-shell {
    border-color: rgba(226, 232, 240, 0.95);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 20px 46px rgba(15, 23, 42, 0.08);
  }

  html:not(.dark) .archive-page .archive-topics-title,
  html:not(.dark) .archive-page .archive-join-title {
    color: #0f172a;
  }

  html:not(.dark) .archive-page .archive-topics-count,
  html:not(.dark) .archive-page .archive-pagination-dots {
    color: #94a3b8;
  }

  html:not(.dark) .archive-page .archive-topics-divider {
    border-top-color: rgba(226, 232, 240, 0.95);
  }

  html:not(.dark) .archive-page .archive-topic-link {
    color: #475569;
  }

  html:not(.dark) .archive-page .archive-topic-link:hover {
    background: rgba(14, 165, 233, 0.06);
    color: #0f172a;
  }

  html:not(.dark) .archive-page .archive-topic-index,
  html:not(.dark) .archive-page .archive-topic-chevron,
  html:not(.dark) .archive-page .archive-pagination-arrow,
  html:not(.dark) .archive-page .archive-pagination-page {
    color: #94a3b8;
  }

  html:not(.dark) .archive-page .archive-topic-chip {
    background: #f1f5f9;
    color: #475569;
  }

  html:not(.dark) .archive-page .archive-join-icon {
    border-color: rgba(14, 165, 233, 0.18);
    background: #f1f5f9;
    color: #0f766e;
  }

  html:not(.dark) .archive-page .archive-join-copy {
    color: #475569;
  }

  html:not(.dark) .archive-page .archive-join-input {
    border-color: rgba(226, 232, 240, 0.95);
    background: #f8fafc;
    color: #0f172a;
  }

  html:not(.dark) .archive-page .archive-join-input::placeholder {
    color: #94a3b8;
  }

  html:not(.dark) .archive-page .archive-join-button {
    background: #0f172a;
    color: #f8fafc;
  }

  html:not(.dark) .archive-page .archive-join-button:hover {
    border-color: #0f172a;
    background: #1e293b;
  }

  html:not(.dark) .archive-page .archive-pagination-current {
    background: #0f172a;
    color: #f8fafc;
  }

  html:not(.dark) #search-wrapper {
    --pagefind-ui-primary: #0f172a;
    --pagefind-ui-text: #475569;
    --pagefind-ui-tag: #0f172a;
  }

  html:not(.dark) #search-wrapper .pagefind-ui__drawer {
    background: rgba(255, 255, 255, 0.98) !important;
    border-color: rgba(226, 232, 240, 0.95) !important;
    box-shadow: 0 22px 48px rgba(15, 23, 42, 0.12) !important;
  }
</style>

<script>
  function initSearchShortcut() {
    const focusSearch = () => {
      const wrapper = document.getElementById("search-wrapper");
      if (!wrapper) return;
      const input = wrapper.querySelector<HTMLInputElement>(
        ".pagefind-ui__search-input",
      );
      if (input) {
        input.focus();
        input.select();
      }
    };

    // Ctrl+K / Cmd+K keyboard shortcut
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        focusSearch();
      }
    });

    const btn = document.getElementById("search-shortcut-btn");
    btn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      focusSearch();
    });
  }

  initSearchShortcut();
  document.addEventListener("astro:after-swap", initSearchShortcut);
</script>
