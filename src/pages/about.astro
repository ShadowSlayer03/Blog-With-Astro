---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SOCIALS, PROJECT_STACK } from "../lib/constants";
import GradientText from "../components/ui/GradientText";
import BorderGlow from "../components/ui/BorderGlow";
import { AnimatedBeam } from "../components/ui/AnimatedBeam";
import { ShimmerButton } from "../components/ui/ShimmerButton";
import { Particles } from "../components/ui/Particles";
---

<BaseLayout
  title={`About - ${SITE.title}`}
  description={`Learn more about ${SITE.author}.`}
>
  <div class="about-page mx-auto max-w-6xl px-6 py-14 md:py-18 lg:py-20">
    <section class="mb-24">
      <div class="flex flex-col items-start">
        <GradientText
          animationSpeed={6}
          showBorder={false}
          client:load
        >
          <h1
            class="font-heading text-[11vw] md:text-[9vw] tracking-normal uppercase leading-none"
          >
            ABOUT
          </h1>
        </GradientText>

        <div class="mt-12 space-y-6">
          <p
            class="about-lead text-xl md:text-2xl font-medium text-slate-200 tracking-tight"
          >
            I'm <span class="about-accent text-cyan-400">Arjun Nambiar</span>, a dev who's
            slightly obsessed with how things work under the hood.
          </p>

          <p
            class="about-copy max-w-2xl text-base md:text-lg leading-relaxed text-slate-400 font-normal"
          >
            I built <strong class="about-strong text-slate-200">this blog</strong> as a digital
            notebook for my late-night experiments.
          </p>

          <p
            class="about-copy max-w-2xl text-base md:text-lg leading-relaxed text-slate-400 font-normal"
          >
            No fluff, just honest thoughts on code, design, and building
            products that actually feel good to use. Thanks for stopping by.
            Follow me on socials if you like what you read!
          </p>

          <div
            class="about-status flex items-center gap-2 font-mono text-[10px] text-cyan-500/50 uppercase tracking-[0.2em] pt-4"
          >
            <span class="h-1.5 w-1.5 bg-cyan-500 rounded-full animate-pulse"
            ></span>
            Currently learning SpringBoot and Generative AI
          </div>
        </div>
      </div>
    </section>

    <div class="mb-32">
      <div
        class="about-section-divider mb-8 flex items-center justify-between border-b border-white/10 pb-4"
      >
        <h2
          class="about-section-title text-lg md:text-2xl font-bold tracking-tight text-white uppercase font-mono"
        >
          Technology Used
        </h2>
        <span class="font-mono text-[10px] text-slate-500"
          >[{PROJECT_STACK.length}_ITEMS]</span
        >
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          PROJECT_STACK.map((item) => (
            <BorderGlow
              className="about-stack-card"
              edgeSensitivity={30}
              borderRadius={12}
              glowRadius={40}
              glowIntensity={0.8}
              coneSpread={25}
              client:load
            >
              <div class="p-6 transition-all group">
                <div class="flex items-start gap-4">
                  <div
                    class="about-stack-icon flex h-12 w-12 shrink-0 items-center justify-center rounded bg-[#1e293b] text-cyan-400 group-hover:bg-cyan-500 group-hover:text-black transition-colors"
                    set:html={item.icon}
                  />
                  <div>
                    <h3 class="about-stack-name text-sm font-bold font-mono text-white">
                      {item.name}
                    </h3>
                    <p class="about-stack-desc mt-1 text-xs text-slate-400 leading-relaxed">
                      {item.desc}
                    </p>
                  </div>
                </div>
              </div>
            </BorderGlow>
          ))
        }
      </div>
    </div>

    <div class="mb-32">
      <div class="mb-12 flex items-center gap-4">
        <h2
          class="about-section-title text-lg md:text-2xl font-bold tracking-tight text-white uppercase font-mono"
        >
          Architecture
        </h2>
        <div class="about-section-line h-px flex-1 bg-linear-to-r from-white/10 to-transparent">
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div
            class="group flex gap-4 transition-transform hover:translate-x-2"
          >
            <div class="about-accent text-cyan-400 mt-1">
              <svg
                width="20"
                height="20"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
              >
            </div>
            <p class="about-arch-copy text-slate-400 leading-relaxed text-sm">
              Leveraging <span class="about-accent text-cyan-400 font-mono italic"
                >Islands Architecture</span
              >, the site maximizes performance by delivering static HTML and
              hydrating components only as needed.
            </p>
          </div>
          <div
            class="group flex gap-4 transition-transform hover:translate-x-2"
          >
            <div class="about-accent text-cyan-400 mt-1">
              <svg
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"><path d="M12 2v20m10-10H2"></path></svg
              >
            </div>
            <p class="about-arch-copy text-slate-400 leading-relaxed text-sm">
              Every content update is a git commit, processed through an
              automated CI/CD pipeline and deployed to a global <span
                class="about-accent text-cyan-400 font-mono italic">Edge Network</span
              >.
            </p>
          </div>
        </div>

        <div
          class="about-beam relative flex w-full items-center justify-center overflow-hidden rounded-xl border border-cyan-500/20 bg-[#050505] p-6 sm:p-12"
          id="beam-container"
        >
          <div
            class="absolute inset-0 opacity-10"
            style="background-image: radial-gradient(#22d3ee 0.5px, transparent 0.5px); background-size: 10px 10px;"
          >
          </div>

          <div
            class="flex h-full w-full flex-row items-center justify-between gap-4 z-10"
          >
            <div
              id="git-source"
              class="about-beam-node p-3 bg-black rounded border border-white/5 text-slate-500"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
              >
            </div>

            <div
              id="astro-core"
              class="p-5 bg-cyan-500 rounded text-black shadow-[0_0_40px_rgba(34,211,238,0.4)]"
            >
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
              >
            </div>

            <div
              id="edge-dest"
              class="about-beam-node p-3 bg-black rounded border border-white/5 text-slate-500"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><line
                  x1="2"
                  y1="12"
                  x2="22"
                  y2="12"></line><path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path></svg
              >
            </div>
          </div>

          <AnimatedBeam
            client:load
            containerRef="beam-container"
            fromRef="git-source"
            toRef="astro-core"
            duration={3}
          />
          <AnimatedBeam
            client:load
            containerRef="beam-container"
            fromRef="astro-core"
            toRef="edge-dest"
            duration={3}
            delay={1.5}
          />

          <span
            class="about-beam-status absolute bottom-1 md:bottom-4 font-mono text-[8px] uppercase tracking-[0.4em] text-cyan-400/50"
          >
            Data_Pipeline_Active
          </span>
        </div>
      </div>
    </div>

    <div
      class="about-cta relative overflow-hidden rounded-2xl border border-white/10 bg-linear-to-b from-[#0f172a] to-transparent p-8 sm:p-16 text-center"
    >
      <Particles
        client:load
        className="absolute inset-0 z-0 h-full w-full"
        quantity={80}
        ease={70}
        staticity={20}
        size={0.8}
      />

      <div class="relative z-10">
        <h2
          class="about-cta-title mb-2 text-xl md:text-3xl font-bold tracking-tight text-white uppercase font-mono"
        >
          Initialize Connection
        </h2>
        <p class="about-cta-copy mb-10 text-sm text-slate-400">
          I post fun stuff, mostly about tech and memes. If you're interested,
          follow along!
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={SOCIALS.twitter} class="group">
            <ShimmerButton
              borderRadius="4px"
              background="#0c1525"
              className="px-8! py-3!"
              client:load
            >
              <div
                class="flex items-center gap-2 font-mono text-xs font-bold uppercase"
              >
                <svg
                  width="14"
                  height="14"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                  ></path></svg
                >
                Twitter
              </div>
            </ShimmerButton>
          </a>
          <a href={SOCIALS.linkedin} class="group">
            <ShimmerButton
              borderRadius="4px"
              shimmerColor="#0077b5"
              background="#071829"
              className="px-8! py-3!"
              client:load
            >
              <div
                class="flex items-center gap-2 font-mono text-xs font-bold uppercase"
              >
                <svg
                  width="14"
                  height="14"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                  ></path></svg
                >
                LinkedIn
              </div>
            </ShimmerButton>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  html:not(.dark) .about-page .about-lead {
    color: #334155;
  }

  html:not(.dark) .about-page .about-copy {
    color: #475569;
  }

  html:not(.dark) .about-page .about-strong,
  html:not(.dark) .about-page .about-section-title,
  html:not(.dark) .about-page .about-stack-name,
  html:not(.dark) .about-page .about-cta-title {
    color: #0f172a;
  }

  html:not(.dark) .about-page .about-accent {
    color: #0891b2;
  }

  html:not(.dark) .about-page .about-status,
  html:not(.dark) .about-page .about-beam-status {
    color: rgba(8, 145, 178, 0.62);
  }

  html:not(.dark) .about-page .about-section-divider {
    border-bottom-color: rgba(226, 232, 240, 0.9);
  }

  html:not(.dark) .about-page .about-section-line {
    background-image: linear-gradient(to right, rgba(226, 232, 240, 0.9), transparent);
  }

  html:not(.dark) .about-page .about-stack-card {
    border-color: rgba(226, 232, 240, 0.95) !important;
    box-shadow: 0 18px 38px rgba(15, 23, 42, 0.08);
  }

  html:not(.dark) .about-page .about-stack-icon {
    background: #f1f5f9;
    color: #0891b2;
  }

  html:not(.dark) .about-page .about-stack-desc,
  html:not(.dark) .about-page .about-arch-copy,
  html:not(.dark) .about-page .about-cta-copy {
    color: #475569;
  }

  html:not(.dark) .about-page .about-beam {
    background: #f8fafc;
  }

  html:not(.dark) .about-page .about-beam-node {
    background: #ffffff;
    border-color: rgba(226, 232, 240, 0.95);
    color: #94a3b8;
  }

  html:not(.dark) .about-page .about-cta {
    border-color: rgba(226, 232, 240, 0.9);
    background-image: linear-gradient(to bottom, #f8fafc, transparent);
  }
</style>
