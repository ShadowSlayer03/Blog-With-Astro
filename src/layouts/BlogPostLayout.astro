---
import BaseLayout from "./BaseLayout.astro";
import TagPill from "../components/TagPill.astro";
import Newsletter from "../components/Newsletter.astro";
import { SITE } from "../lib/constants";
import { formatDate } from "../lib/utils";
import type { CollectionEntry } from "astro:content";

import ScrollProgress from "../components/islands/ScrollProgress";
import TableOfContents from "../components/islands/TableOfContents";
import LikeButton from "../components/islands/LikeButton";
import ShareButton from "../components/islands/ShareButton";
import GiscusComments from "../components/islands/GiscusComments";
import BackToTop from "../components/islands/BackToTop";
import TrackPageView from "../components/islands/TrackPageView";
import ViewCount from "../components/islands/ViewCount";
import GradientText from "../components/ui/GradientText";
import { Toaster } from "sonner";
import Image from "astro/components/Image.astro";

type Props = CollectionEntry<"blog">["data"] & {
  slug: string;
  rawContent?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  slug,
  rawContent,
} = Astro.props;

const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;

const wordCount = rawContent ? rawContent.trim().split(/\s+/).length : 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));

const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const ogImage = heroImage || `/og/${slug}.png`;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  article={true}
  isBlogPost={true}
>
  <TrackPageView client:idle slug={slug} readingTime={readingMinutes} />
  <ScrollProgress client:idle />
  <div class="blog-layout isolate relative overflow-clip">
    <div class="blog-backdrop pointer-events-none absolute inset-0 -z-10">
      <div
        class="blog-backdrop-grid absolute inset-0 opacity-80"
        style="background-image: linear-gradient(rgba(34, 211, 238, 0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(34, 211, 238, 0.025) 1px, transparent 1px); background-size: 28px 28px;"
      >
      </div>
      <div
        class="blog-backdrop-orb absolute left-1/2 top-0 h-128 w-lg -translate-x-1/2 rounded-full bg-cyan-500/12 blur-3xl"
      >
      </div>
      <div
        class="blog-backdrop-gradient absolute inset-x-0 top-0 h-48 bg-linear-to-b from-cyan-500/8 to-transparent"
      >
      </div>
    </div>

    <section
      class="blog-header-section relative border-b border-slate-200 dark:border-white/6"
    >
      <div class="mx-auto max-w-6xl px-6 pb-16 pt-16 md:pb-20 md:pt-24">
        <div class="mx-auto max-w-4xl text-center">
          <div
            class="blog-date-pill mb-8 inline-flex flex-wrap items-center justify-center gap-3 rounded-full border border-slate-200 dark:border-cyan-500/15 bg-white/90 dark:bg-[#08111f]/90 px-4 py-2 font-mono text-[9px] uppercase tracking-[0.35em] text-cyan-700/80 dark:text-cyan-300/75 shadow-[0_4px_14px_rgba(15,23,42,0.06)] dark:shadow-[0_0_0_1px_rgba(8,145,178,0.08)]"
          >
            <span>{formattedPubDate.toUpperCase()}</span>
            {
              formattedUpdatedDate && (
                <>
                  <span class="text-slate-400 dark:text-slate-600">/</span>
                  <span>Updated {formattedUpdatedDate.toUpperCase()}</span>
                </>
              )
            }
          </div>

          <GradientText animationSpeed={6} showBorder={false} client:idle>
            <h1
              class="blog-title font-heading text-balance text-4xl md:text-7xl font-black uppercase leading-[0.92] tracking-wider"
            >
              {title}
            </h1>
          </GradientText>

          <p
            class="blog-description mx-auto mt-8 max-w-2xl text-sm md:text-lg leading-8 text-slate-600 dark:text-slate-400"
          >
            {description}
          </p>

          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <div
              class="blog-meta-author inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-white/8 bg-white/90 dark:bg-[#08111f]/90 px-4 py-2 font-mono text-[10px] uppercase tracking-[0.28em] text-slate-600 dark:text-slate-300"
            >
              <div
                class="h-6 w-6 overflow-hidden rounded-full border border-slate-200 dark:border-cyan-500/40 bg-slate-100 dark:bg-cyan-950"
              >
                <Image
                  width={24}
                  height={24}
                  alt="Author profile picture"
                  src={import.meta.env.PUBLIC_AUTHOR_DP}
                  class="h-full w-full object-cover"
                  onerror="this.style.display='none'"
                />
              </div>
              <span>{SITE.author}</span>
            </div>
            {
              wordCount > 0 && (
                <div class="blog-meta-read inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-white/8 bg-white/90 dark:bg-[#08111f]/90 px-4 py-2 font-mono text-[10px] uppercase tracking-[0.28em] text-slate-600 dark:text-slate-300">
                  <svg
                    class="h-3.5 w-3.5 text-cyan-600 dark:text-cyan-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  <span>{readingMinutes} min read</span>
                </div>
              )
            }
            <div
              class="blog-meta-views inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-white/8 bg-white/90 dark:bg-[#08111f]/90 px-4 py-2 font-mono text-[10px] uppercase tracking-[0.28em] text-slate-600 dark:text-slate-300"
            >
              <ViewCount slug={slug} client:visible />
            </div>
          </div>

          {
            tags && tags.length > 0 && (
              <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
                {tags.map((tag) => (
                  <TagPill tag={tag} size="sm" />
                ))}
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="relative mx-auto max-w-7xl px-6 pb-24 pt-10 md:pt-14">
      <div class="grid gap-10 xl:grid-cols-[180px_minmax(0,1fr)_240px]">
        <aside class="hidden xl:block">
          <div class="sticky top-28 space-y-12">
            <a
              href="/blog"
              class="group inline-flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.3em] text-slate-500 transition-colors hover:text-cyan-600 dark:hover:text-cyan-400"
            >
              <svg
                class="h-3 w-3 transition-transform group-hover:-translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
              </svg>
              BACK_TO_ROOT
            </a>

            <div class="blog-sidebar-data">
              <div class="mb-6 flex items-center gap-2">
                <span class="block h-3 w-1 bg-cyan-400"></span>
                <span
                  class="blog-system-data font-mono text-[9px] font-bold uppercase tracking-[0.3em] text-white"
                  >SYSTEM_DATA</span
                >
              </div>
              <ul
                class="space-y-4 font-mono text-[9px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-500"
              >
                <li
                  class="group flex items-start gap-1.5 transition-all duration-200"
                >
                  <span
                    class="text-slate-400 dark:text-slate-700/70 group-hover:text-slate-600 dark:group-hover:text-slate-500 transition-colors"
                    >01_</span
                  >
                  <div class="mt-0.5 leading-[1.4]">
                    <span
                      class="block mb-0.5 text-slate-700 dark:text-slate-400"
                      >PUBLISHED</span
                    >
                    <span class="text-slate-500 dark:text-slate-400"
                      >{formattedPubDate.replace(/\s+/g, "_")}</span
                    >
                  </div>
                </li>
                {
                  formattedUpdatedDate && (
                    <li class="group flex items-start gap-1.5 transition-all duration-200">
                      <span class="text-slate-400 dark:text-slate-700/70 group-hover:text-slate-600 dark:group-hover:text-slate-500 transition-colors">
                        02_
                      </span>
                      <div class="mt-0.5 leading-[1.4]">
                        <span class="block mb-0.5 text-slate-700 dark:text-slate-400">
                          UPDATED
                        </span>
                        <span class="text-slate-500 dark:text-slate-400">
                          {formattedUpdatedDate.replace(/\s+/g, "_")}
                        </span>
                      </div>
                    </li>
                  )
                }
                <li
                  class="group flex items-start gap-1.5 transition-all duration-200"
                >
                  <span
                    class="text-slate-400 dark:text-slate-700/70 group-hover:text-slate-600 dark:group-hover:text-slate-500 transition-colors"
                  >
                    {formattedUpdatedDate ? "03_" : "02_"}
                  </span>
                  <div class="mt-0.5 leading-[1.4]">
                    <span
                      class="block mb-0.5 text-slate-700 dark:text-slate-400"
                      >READ_TIME</span
                    >
                    <span class="text-slate-500 dark:text-slate-400"
                      >{readingMinutes}_MIN</span
                    >
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </aside>

        <article class="min-w-0" data-pagefind-body>
          <a
            href="/blog"
            class="group mb-8 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.28em] text-slate-500 transition-colors hover:text-cyan-600 dark:hover:text-cyan-400 xl:hidden"
          >
            <svg
              class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
            </svg>
            Back to all posts
          </a>

          {
            heroImage && (
              <div class="blog-hero-image mb-12 overflow-hidden rounded-[28px] border border-slate-200 dark:border-white/8 bg-slate-50 dark:bg-[#050b16] shadow-[0_14px_40px_rgba(15,23,42,0.06)] dark:shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
                <Image
                  width={1200}
                  height={675}
                  src={heroImage}
                  alt={title}
                  class="aspect-video w-full object-cover"
                  loading="eager"
                />
              </div>
            )
          }

          <div
            id="post-content"
            class="blog-post-prose prose dark:prose-invert max-w-none"
          >
            <slot />
          </div>

          <div
            class="mt-16 flex flex-wrap items-center gap-3 border-t border-slate-200 dark:border-white/6 pt-8"
          >
            <LikeButton client:visible slug={slug} />
            <ShareButton client:visible title={title} url={currentUrl} />
          </div>

          <div
            class="blog-author-note-card relative mt-12 overflow-hidden rounded-[28px] border border-white/6 bg-[#07101c]/90 p-8 backdrop-blur-sm md:p-10"
          >
            <div
              class="blog-author-note-glow absolute -right-16 top-0 h-36 w-36 rounded-full bg-cyan-500/10 blur-3xl"
            >
            </div>
            <div
              class="relative flex flex-col gap-6 md:flex-row md:items-center"
            >
              <div class="shrink-0">
                <div
                  class="blog-author-note-avatar h-32 w-32 overflow-hidden rounded-3xl border border-white/10 bg-[#020617]"
                >
                  <Image
                    width={128}
                    height={128}
                    src={import.meta.env.PUBLIC_AUTHOR_DP}
                    class="h-full w-full object-cover"
                    alt="Author profile picture"
                    onerror="this.style.display='none'"
                  />
                </div>
              </div>
              <div>
                <p
                  class="blog-author-note-eyebrow font-mono text-[9px] uppercase tracking-[0.35em] text-cyan-400/70"
                >
                  About the Author
                </p>
                <h4
                  class="blog-author-note-title mt-2 text-2xl font-bold tracking-tight text-white"
                >
                  Arjun Nambiar
                </h4>
                <p
                  class="blog-author-note-desc mt-3 max-w-2xl text-sm leading-normal text-slate-400"
                >
                  Arjun is a writer and developer who enjoys exploring where
                  technology meets creativity and storytelling. As a software
                  engineer with a strong eye for design, he builds engaging web
                  experiences that aim to both inspire and inform people around
                  the world. Outside of work, you'll likely find him gaming,
                  hiking, or unwinding with a good cup of tea.
                </p>
              </div>
            </div>
          </div>

          <div class="mt-14">
            <Newsletter />
          </div>

          <div
            class="mt-14 border-t border-slate-200 dark:border-white/6 pt-10"
          >
            <h3
              class="mb-6 font-mono text-[10px] uppercase tracking-[0.35em] text-slate-500"
            >
              Comments
            </h3>
            <GiscusComments client:visible />
          </div>
        </article>

        <aside class="hidden xl:block">
          <TableOfContents client:idle />
        </aside>
      </div>
    </section>
  </div>

  <BackToTop client:idle />
  <Toaster client:only="react" theme="system" richColors closeButton />
</BaseLayout>

<style is:global>
  /* LIGHT MODE OVERRIDES FOR GLOBAL TYPOGRAPHY */
  html:not(.dark) .blog-backdrop-grid {
    opacity: 0.45;
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px) !important;
  }
  html:not(.dark) .blog-backdrop-gradient {
    background:
      radial-gradient(circle at top, rgba(14, 116, 144, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(248, 250, 252, 0.1) 0%, transparent 100%) !important;
  }
  html:not(.dark) .blog-backdrop-orb {
    background: rgba(14, 165, 233, 0.08);
  }

  html:not(.dark) .blog-system-data {
    color: var(--color-accent-dark);
  }

  /* Prose Overrides */
  html:not(.dark) .blog-post-prose {
    color: #334155;
  }
  html:not(.dark) .blog-post-prose > :where(p:first-of-type)::first-letter {
    color: #0f172a;
  }
  html:not(.dark) .blog-post-prose :where(h2),
  html:not(.dark) .blog-post-prose :where(h3),
  html:not(.dark) .blog-post-prose :where(h4) {
    color: #0f172a;
  }
  html:not(.dark) .blog-post-prose :where(p, li) {
    color: #334155;
  }
  html:not(.dark) .blog-post-prose :where(strong) {
    color: #0f172a;
  }
  html:not(.dark) .blog-post-prose :where(a) {
    color: #0891b2;
  }
  html:not(.dark) .blog-post-prose :where(a:hover) {
    color: #0e7490;
  }
  html:not(.dark) .blog-post-prose :where(img) {
    border-color: rgba(15, 23, 42, 0.08);
    background: #f8fafc;
    box-shadow:
      inset 0 1px 0 rgba(15, 23, 42, 0.04),
      0 20px 46px rgba(15, 23, 42, 0.06);
  }

  html:not(.dark) .blog-post-prose :where(pre) {
    border-color: rgba(15, 23, 42, 0.08);
    background-color: var(--shiki-light-bg, #f8fafc) !important;
    color: var(--shiki-light, #334155) !important;
    box-shadow:
      inset 0 1px 0 rgba(15, 23, 42, 0.04),
      0 20px 46px rgba(15, 23, 42, 0.06);
  }
  html:not(.dark) .blog-post-prose :where(pre span) {
    color: var(--shiki-light) !important;
  }

  html.dark .blog-post-prose :where(pre) {
    background-color: var(--shiki-dark-bg, #040814) !important;
    color: var(--shiki-dark) !important;
  }
  html.dark .blog-post-prose :where(pre span) {
    color: var(--shiki-dark) !important;
  }

  html:not(.dark) .blog-author-note-card {
    background: rgba(255, 255, 255, 0.94);
    border-color: #e2e8f0;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
  }
  html:not(.dark) .blog-author-note-glow {
    background: rgba(8, 145, 178, 0.05); /* Soft cyan glow */
  }
  html:not(.dark) .blog-author-note-avatar {
    border-color: #e2e8f0;
    background: #f8fafc;
  }
  html:not(.dark) .blog-author-note-title {
    color: #0f172a;
  }
  html:not(.dark) .blog-author-note-desc {
    color: #475569;
  }
  html:not(.dark) .blog-author-note-eyebrow {
    color: #0891b2;
  }
</style>
